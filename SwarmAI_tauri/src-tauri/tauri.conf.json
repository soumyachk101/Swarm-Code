{
 "$schema": "https://schema.tauri.app/config/2.0.0",
 "productName": "SwarmAI",
 "version": "1.0.0",
 "identifier": "com.swarmai.app",
 "app": {
  "withGlobalTauri": true,
  "windows": [
   {
    "title": "SwarmAI",
    "width": 1400,
    "height": 900,
    "resizable": true,
    "fullscreen": false
   }
  ]
 },
 "bundle": {
  "active": true,
  "icon": [
   "icons/32x32.png",
   "icons/128x128.png",
   "icons/128x128@2x.png"
  ]
 },
 "build": {
  "beforeDevCommand": "npm run dev",
  "beforeBuildCommand": "npm run build",
  "devUrl": "http://localhost:5173",
  "frontendDist": "../dist"
 }
}
