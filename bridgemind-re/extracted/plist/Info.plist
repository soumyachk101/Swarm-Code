<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>BridgeMind</string>
    <key>CFBundleDisplayName</key><string>BridgeMind</string>
    <key>CFBundleIdentifier</key><string>ai.bridgemind.one</string>
    <key>CFBundleVersion</key><string>0.1.12</string>
    <key>CFBundleShortVersionString</key><string>0.1.12</string>
    <key>CFBundleExecutable</key><string>BridgeMindOne</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>LSMinimumSystemVersion</key><string>26.0</string>
    <key>LSApplicationCategoryType</key><string>public.app-category.developer-tools</string>
    <key>NSHumanReadableCopyright</key><string>Copyright © BridgeMind LLC. All rights reserved.</string>
    <key>NSHighResolutionCapable</key><true/>
    <!-- Which identity this bundle runs under (AppFlavor.swift). Baked in
         because a launched .app never sees the terminal's environment. -->
    <key>BMOneFlavor</key><string>standard</string>
    <!-- Which swift configuration produced the binary. Nothing at runtime
         reads it ( is authoritative there) — it exists so
         scripts/make-dmg.sh and scripts/publish-cdn.sh can refuse to ship a
         bundle that was never built for shipping. -->
    <key>BMOneBuildConfig</key><string>release</string>
    <!-- Build provenance (Perf/Perf.swift reads BMOneGitSHA). -->
    <key>BMOneGitSHA</key><string>88ada94ca0646bf9affd2c0dd192736b92dcc4a9</string>
    <!-- Sparkle auto-update (Updates/UpdateController.swift). SUFeedURL is the
         EdDSA-signed appcast on the downloads CDN. It lives under latest/
         because that is the only prefix the rollback role may write: a feed at
         the product root could never be repaired after a bad release, and
         clients would keep auto-installing the version we withdrew. Only the
         *enclosure* has to be immutable, and it is. SUPublicEDKey is the public
         half of the BridgeMind One signing key (account "bridgemind-one" in
         the release machine's login Keychain; the private half exists in CI
         only as the SPARKLE_ED_PRIVATE_KEY secret). SUEnableAutomaticChecks
         suppresses Sparkle's first-run "check automatically?" prompt — the
         Settings toggle owns that answer instead. SUAutomaticallyUpdate is
         what makes the sidebar row an instant restart rather than a download:
         Sparkle pulls and stages the update in the background, and only then
         is there anything to nudge about. -->
    <key>SUFeedURL</key><string>https://downloads.bridgemind.ai/bridgemind-one/latest/appcast.xml</string>
    <key>SUPublicEDKey</key><string>qDys+F+w3LbYwVY20c0PCDFloXwhuuKQmCyZfbtYTKY=</string>
    <key>SUEnableAutomaticChecks</key><true/>
    <key>SUAutomaticallyUpdate</key><true/>
    <key>SUScheduledCheckInterval</key><integer>14400</integer>
    <!-- Product analytics (Analytics/Analytics.swift). Empty on every
         local build. The CI release job bakes the public write-only
         token for project bridgemind-one (id 571790). Never printed. -->
    <key>BMOnePostHogKey</key><string>phc_xwHPCc9bhzdrsFSKZRvdZf2estjpbvTTghvDqzKKSPmS</string>





    <key>NSMicrophoneUsageDescription</key>
    <string>BridgeMind listens when you press fn so it can transcribe what you say and paste it where you were typing.</string>
    <!-- TCC Files and Folders. Without these strings macOS 26 denies Desktop /
         Documents / Downloads silently (EPERM), and a child codex / claude
         in a Code-mode PTY dies at getcwd. The grant is on this app, not Terminal. -->
    <key>NSDesktopFolderUsageDescription</key>
    <string>BridgeMind opens project folders you add as workspaces, including any that live on your Desktop, so agent terminals can run there.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>BridgeMind opens project folders you add as workspaces, including any that live in Documents.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>BridgeMind opens project folders you add as workspaces, including any that live in Downloads.</string>
    <!-- Debug (and any override) talks HTTP to localhost. Without this ATS
         blocks the .app from reaching the local API / login page. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key><true/>
    </dict>
    <!-- bridgemind-one://focus — the "Open BridgeMind One" button on the
         sign-in success page. Sign-in itself never depends on this: the flow
         is loopback-based (see Auth/LoopbackCallbackServer.swift). -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key><string>ai.bridgemind.one.auth</string>
            <key>CFBundleURLSchemes</key>
            <array><string>bridgemind-one</string></array>
        </dict>
    </array>
</dict>
</plist>
