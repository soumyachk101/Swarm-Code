{
	"$schema": "https://schema.tauri.app/config/2.0.0",
	"productName": "Swarm Code Mobile",
	"version": "0.1.0",
	"identifier": "com.swarmcode.mobile",
	"build": {
		"beforeDevCommand": "pnpm run dev",
		"beforeBuildCommand": "pnpm run build",
		"devUrl": "http://localhost:5174",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "Swarm Code Mobile",
				"width": 390,
				"height": 844,
				"resizable": false,
				"hiddenTitle": true,
				"titleBarStyle": "Overlay"
			}
		]
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"longDescription": "Control Swarm Code from your phone — view chats, send messages, approve actions, and see diffs from anywhere on your local network."
	}
}
