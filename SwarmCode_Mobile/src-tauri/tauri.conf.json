{
	"$schema": "https://schema.tauri.app/config/2.0.0",
	"productName": "SwarmAI Mobile",
	"version": "0.1.0",
	"identifier": "com.swarmai.mobile",
	"build": {
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build",
		"devUrl": "http://localhost:5174",
		"frontendDist": "../dist-mobile"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "SwarmAI Mobile",
				"width": 390,
				"height": 844,
				"resizable": false,
				"hiddenTitle": true,
				"titleBarStyle": "Overlay"
			}
		]
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"longDescription": "Control SwarmAI from your phone — view chats, send messages, approve actions, and see diffs from anywhere on your local network.",
		"macOS": {
			"minimumSystemVersion": "14.0"
		},
		"ios": {
			"minimumSystemVersion": "16.0"
		},
		"android": {
			"minSdkVersion": 24,
			"versionCode": 1
		}
	}
}
